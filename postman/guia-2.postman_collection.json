{
  "info": {
    "name": "Guía 2 - Productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Reiniciar la API desde IntelliJ antes de ejecutar. Usar IDs existentes. El POST del paso 5 usa categoriaId=2 como en la guía; verificar esa categoría antes de enviarlo. El código TEC-001 debe ser único."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productoId",
      "value": "1"
    },
    {
      "key": "categoriaId",
      "value": "1"
    },
    {
      "key": "etiquetaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Buscar producto por ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos/{{productoId}}"
      }
    },
    {
      "name": "Paso 5 - Registrar producto con DTO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"existencia\": 20,\r\n  \"categoriaId\": 2,\r\n  \"nombre\": \"Teclado mecánico\",\r\n  \"precioVenta\": 75.5,\r\n  \"codigo\": \"TEC-001\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 6 - Actualizar producto con DTO",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "description": "Usar el ID del producto a actualizar y una categoriaId existente. El código no debe pertenecer a otro producto.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"codigo\": \"TEC-001\",\r\n  \"nombre\": \"Teclado mecánico actualizado\",\r\n  \"precioVenta\": 80.5,\r\n  \"existencia\": 15,\r\n  \"categoriaId\": 2\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 7 - Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/productos/{{productoId}}",
        "description": "Elimina el producto indicado por productoId. Usar un ID existente. Resultado esperado: 204 No Content."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Sin contenido\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Paso 9 - Consultar productos por categoria",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos/categoria/{{categoriaId}}"
      }
    },
    {
      "name": "Paso 13 - Crear etiqueta Oferta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/etiquetas",
        "description": "Esta etiqueta ya existe en la base local. Repetir el mismo nombre produce un conflicto por la restricción UNIQUE.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Oferta\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 13 - Crear etiqueta Importado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/etiquetas",
        "description": "Esta etiqueta ya existe en la base local. Repetir el mismo nombre produce un conflicto por la restricción UNIQUE.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Importado\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 13 - Crear etiqueta Empresarial",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/etiquetas",
        "description": "Esta etiqueta ya existe en la base local. Repetir el mismo nombre produce un conflicto por la restricción UNIQUE.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Empresarial\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 13 - Crear etiqueta Portátil",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/etiquetas",
        "description": "Esta etiqueta ya existe en la base local. Repetir el mismo nombre produce un conflicto por la restricción UNIQUE.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Portátil\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 13 - Crear etiqueta Gaming",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/etiquetas",
        "description": "Esta etiqueta ya existe en la base local. Repetir el mismo nombre produce un conflicto por la restricción UNIQUE.",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nombre\": \"Gaming\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Paso 14 - Asociar etiqueta a producto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/productos/{{productoId}}/etiquetas/{{etiquetaId}}",
        "description": "Sin body. Configurar productoId=2 y etiquetaId=1 para el ejemplo de la guía, si existen ambos registros."
      }
    },
    {
      "name": "Reto 1 - Eliminar asociacion de etiqueta",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/productos/{{productoId}}/etiquetas/{{etiquetaId}}",
        "description": "Sin body. Retira únicamente la asociación y devuelve el producto actualizado con HTTP 200."
      }
    }
  ]
}
