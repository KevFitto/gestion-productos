{
  "info": {
    "name": "Gestión de productos — JPA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con la API iniciada. Cada ejecución crea registros nuevos. Los IDs se capturan automáticamente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 Crear Computadoras",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Computadoras\",\n  \"activa\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"categoriaComputadoras\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
